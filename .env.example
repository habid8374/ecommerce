# Copy to .env and adjust before running `docker compose up`.

# Database
DB_NAME=ecommerce

# Security — REQUIRED. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# CORS: with the bundled nginx proxy the frontend is same-origin, so "*" is fine.
# For a split deployment, set your real frontend origin(s), comma-separated.
CORS_ORIGINS=*

# Public URL where users reach the frontend (used to build the Wompi redirect).
FRONTEND_URL=http://localhost:8080

# Bootstrap admin (created on first startup)
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=change-this-admin-password

# ---- Wompi ----
# Leave blank to run in SIMULATED payment mode (no real charges).
# Fill all four (from https://comercios.wompi.co) to enable real checkout.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
