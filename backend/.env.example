# ---- Database ----
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=ecommerce

# ---- Security ----
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Bootstrap admin (created on startup if it doesn't exist) ----
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Administrador

# ---- CORS (comma-separated origins; use your real frontend URL in prod) ----
CORS_ORIGINS=http://localhost:3000

# ---- Frontend URL (used to build the Wompi redirect) ----
FRONTEND_URL=http://localhost:3000

# ---- Shipping (whole COP pesos) ----
SHIPPING_COST=15000
FREE_SHIPPING_OVER=150000

# ---- Wompi (https://comercios.wompi.co) ----
# Leave blank to run in SIMULATED payment mode (great for local dev / demos).
# Fill all four to enable real Wompi checkout.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Sandbox: https://sandbox.wompi.co/v1  | Production: https://production.wompi.co/v1
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
CURRENCY=COP

# Force-disable the dev "simulate payment" endpoint (auto-off when Wompi keys are set)
# SIMULATE_PAYMENTS=false
